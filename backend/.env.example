# API
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
APP_NAME=LaSaTrading Backend
APP_VERSION=0.1.0

# PostgreSQL
POSTGRES_USER=lasa
POSTGRES_PASSWORD=lasa
POSTGRES_DB=lasa
DATABASE_URL=postgresql://lasa:lasa@localhost:5432/lasa

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# CORS
CORS_ORIGINS=["http://localhost:5173"]