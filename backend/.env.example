# API
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
APP_NAME=LaSaTrading Backend
APP_VERSION=0.1.0

# PostgreSQL
POSTGRES_USER=lasa
POSTGRES_PASSWORD=lasa
POSTGRES_DB=lasa
DATABASE_URL=postgresql://lasa:lasa@localhost:5432/lasa

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Binance
BINANCE_API_BASE_URL=https://api.binance.com
BINANCE_SYMBOLS_CACHE_TTL=86400
BINANCE_THROTTLE_MS=100
BINANCE_MAX_RETRIES=3
BINANCE_RETRY_BACKOFF_BASE=1.0
BINANCE_429_RETRY_WAIT_SECONDS=60
BINANCE_REQUEST_TIMEOUT=30.0
BINANCE_KLINES_LIMIT=1000

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# Alertas (Tarea 6 · Telegram)
#
# `TELEGRAM_ENABLED` va en false a proposito: hasta que pongas aqui un token
# real, el modulo de alertas esta desplegado y no envia nada. Ponlo en true solo
# cuando los tres valores esten puestos.
#
# El token es un secreto: sale de `@BotFather` y no se versiona jamas. Si se
# filtra, `@BotFather` lo revoca y genera otro.
#
# El `chat_id` NO se busca solo, porque un bot no puede escribir a alguien que
# no le haya escrito primero:
#   1. Habla con @BotFather y crea el bot. Devuelve el token.
#   2. Abre el chat con tu bot y mandale `/start`.
#   3. GET https://api.telegram.org/bot<TOKEN>/getUpdates -> busca "chat":{"id":...}
#   4. Pegalo aqui.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_INTERVAL_SECONDS=1.0
TELEGRAM_MAX_ATTEMPTS=5
TELEGRAM_MAX_MESSAGE_CHARS=4096
